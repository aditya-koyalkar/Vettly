# ==============================================================================
# Vettly API Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vettly_db
POSTGRES_PORT=5432

# Prisma Database Connection URL with Connection Pool Configuration:
# - connection_limit: Max number of physical PostgreSQL connections in the pool (default: num_cpus * 2 + 1)
# - pool_timeout: Max seconds to wait for an available connection from the pool before timing out
# Inside Docker Compose network (api -> postgres):
DATABASE_URL="postgresql://postgres:your_secure_password_here@postgres:5432/vettly_db?schema=public&connection_limit=10&pool_timeout=20"
# If running API directly on host machine (outside Docker):
# DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/vettly_db?schema=public&connection_limit=10&pool_timeout=20"

# Redis Configuration (Single multiplexed connection with automatic keep-alive and exponential retry)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"
# If running API directly on host machine (outside Docker):
# REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Microservices & Frontend
COPILOT_SERVICE_URL=http://copilot:8000
FRONTEND_URL=http://localhost:5173

# LiveKit Configuration (Voice AI)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
