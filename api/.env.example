NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Postgres (pgvector) — also used by the postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vettly_db
# Use @localhost when running the API outside Docker
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/vettly_db?schema=public"
REDIS_URL="redis://redis:6379"

JWT_SECRET=change-me-to-a-long-random-string

# Shared with livekit-agent/.env
API_SERVICE_KEY=change-me-to-a-long-random-string

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=vettly-interviewer

# Primary: Gemini free tier. Embeddings use gemini-embedding-001 @ 768 dims.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Fallback: Groq free tier
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
