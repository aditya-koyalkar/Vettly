# ==============================================================================
# Vettly API & Copilot Environment Configuration (Single Source of Truth)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vettly_db
POSTGRES_PORT=5432

# Prisma Database Connection URL
# - Inside Docker Compose network (api -> postgres):
DATABASE_URL="postgresql://postgres:your_secure_password_here@postgres:5432/vettly_db?schema=public&connection_limit=10&pool_timeout=20"
# - Outside Docker (running locally on host):
# DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/vettly_db?schema=public&connection_limit=10&pool_timeout=20"

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"
# Outside Docker:
# REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# OpenAI API Key (used by in-process LangGraph Copilot)
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# LiveKit Configuration (Voice AI)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
