# LiveKit Cloud project (authorises LiveKit Inference fallbacks + VAD)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vettly API internal routes (must match API_SERVICE_KEY in api/.env)
API_SERVICE_URL=http://localhost:3000
API_SERVICE_KEY=

# Primary STT & TTS: direct Deepgram API
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=flux-general-multi
# DEEPGRAM_STT_LANGUAGE=en-IN
# DEEPGRAM_TTS_MODEL=aura-2-asteria-en
# DEEPGRAM_FLUX_EOT_THRESHOLD=0.75
# DEEPGRAM_FLUX_EAGER_EOT_THRESHOLD=0.5
# DEEPGRAM_FLUX_EOT_TIMEOUT_MS=5000
# DEEPGRAM_ENDPOINTING_MS=500

# Server-side Krisp filter before VAD/STT: nc (noise only, default) | bvc (also strips
# background voices; can eat soft/distant speech) | off
# NOISE_CANCELLATION=nc

# Primary & secondary LLM: OpenRouter (key 1 -> key 2 -> LiveKit Inference)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_SECONDARY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# LiveKit Inference (STT/TTS fallbacks after Direct Deepgram; LLM 3rd fallback)
# LIVEKIT_STT_MODEL=deepgram/flux-general-multi
# LIVEKIT_STT_LANGUAGE=en
# LIVEKIT_STT_FALLBACK_MODEL=deepgram/nova-3
# LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
# LIVEKIT_TTS_MODEL=fishaudio/s2.1-pro-free
# LIVEKIT_TTS_FALLBACK_MODEL=deepgram/aura-2:athena
# LIVEKIT_TTS_FALLBACK_MODEL_2=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
