# LiveKit Cloud project (authorises LiveKit Inference STT/LLM/TTS + VAD)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vettly API internal routes (must match API_SERVICE_KEY in api/.env)
API_SERVICE_URL=http://localhost:3000
API_SERVICE_KEY=

# Primary STT & TTS: direct Deepgram API
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_STT_LANGUAGE=en-IN
# DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Optional overrides for LiveKit Inference (LLM primary, STT/TTS fallback)
# LIVEKIT_STT_MODEL=deepgram/nova-3
# LIVEKIT_STT_LANGUAGE=en-IN
# LIVEKIT_STT_FALLBACK_MODEL=assemblyai/assemblyai-stt-3-7-realtime-agent
# LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
# LIVEKIT_TTS_MODEL=deepgram/aura-2:athena
# LIVEKIT_TTS_FALLBACK_MODEL=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Fallback tier: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_LLM_MODEL=google/gemini-3.8-flash
# OPENROUTER_LLM_FALLBACK_1=qwen/qwen3.8-flash
# OPENROUTER_LLM_FALLBACK_2=openai/gpt-5.6-luna
# OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
# OPENROUTER_STT_FALLBACK_1=mistralai/voxtral-mini-transcribe-3-0
# OPENROUTER_STT_FALLBACK_2=microsoft/mai-transcribe-2
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts:Kore
# OPENROUTER_TTS_FALLBACK_1=mistralai/voxtral-mini-tts-3-0:en_paul_neutral
# OPENROUTER_TTS_FALLBACK_2=hexgrad/kokoro-82m:af_heart
