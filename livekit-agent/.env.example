# LiveKit Cloud project (also authorises LiveKit Inference free-tier STT/LLM/TTS)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vettly API internal routes (must match API_SERVICE_KEY in api/.env)
API_SERVICE_URL=http://localhost:3000
API_SERVICE_KEY=

# Fallback tier 2: Gemini free tier (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# Fallback tier 3: Groq free tier (https://console.groq.com)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Optional overrides for the LiveKit Inference tier
# LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
# LIVEKIT_STT_MODEL=deepgram/nova-3
# LIVEKIT_TTS_MODEL=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
